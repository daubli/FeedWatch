<?xml version="1.0" encoding="utf-8"?>
<!-- Rows that can be clicked get the focus ring when the TV remote is on them -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/fw_card_radius"/>
            <solid android:color="@color/fw_surface_raised"/>
            <stroke android:width="2dp" android:color="@color/fw_focus"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/fw_card_radius"/>
            <solid android:color="@color/fw_surface"/>
            <stroke android:width="1dp" android:color="@color/fw_outline"/>
        </shape>
    </item>
</selector>
