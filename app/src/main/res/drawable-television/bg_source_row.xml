<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/fw_hud_pressed">
    <item>
        <!-- the list marks the row the TV remote is on as selected -->
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/fw_card_radius"/>
                    <solid android:color="@color/fw_surface_raised"/>
                    <stroke android:width="2dp" android:color="@color/fw_focus"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/fw_card_radius"/>
                    <solid android:color="@color/fw_surface"/>
                    <stroke android:width="1dp" android:color="@color/fw_outline"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
