<?xml version="1.0" encoding="utf-8"?>
<!-- A HUD chip that can be tapped, like the stats button. Activated while its popup is open. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <solid android:color="@color/fw_hud_pressed"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <solid android:color="@color/fw_accent_dim"/>
            <stroke android:width="1dp" android:color="@color/fw_accent"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <solid android:color="@color/fw_hud_chip"/>
        </shape>
    </item>
</selector>
