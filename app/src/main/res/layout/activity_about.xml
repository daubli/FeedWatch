<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/fw_background"
              android:orientation="vertical"
              tools:context=".AboutActivity">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.FeedWatch.Toolbar"
            app:navigationContentDescription="@string/abc_action_bar_up_description"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/menu_about"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

        <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher_round"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/fw_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"/>

        <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/fw_text_secondary"
                android:textSize="14sp"
                tools:text="Version 1.1"/>

        <TextView
                android:id="@+id/buildText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/fw_text_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp"
                tools:text="Build c00f55b1a2b3c4d5"/>

        <TextView
                android:id="@+id/ndiNotice"
                android:layout_width="match_parent"
                android:autoLink="web"
                android:textColorLink="@color/fw_accent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_settings_card"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:padding="16dp"
                android:text="@string/ndi_license"
                android:textColor="@color/fw_text_secondary"
                android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>
