<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/fw_background"
              android:orientation="vertical"
              tools:context=".SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.FeedWatch.Toolbar"
            app:navigationContentDescription="@string/abc_action_bar_up_description"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/menu_settings"/>

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/fw_screen_padding"
                android:paddingEnd="@dimen/fw_screen_padding"
                android:paddingBottom="@dimen/fw_screen_padding">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_section_network"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.FeedWatch.SectionLabel"/>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/settings_additional_sources"
                        app:boxStrokeColor="@color/fw_accent"
                        app:helperText="@string/settings_additional_sources_helper"
                        app:hintTextColor="@color/fw_accent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/additionalSourcesEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textNoSuggestions|textUri"
                            android:maxLines="3"
                            android:textColor="@color/fw_text_primary"
                            android:textSize="15sp"
                            tools:text="192.168.1.20,192.168.1.21"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_section_stream"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.FeedWatch.SectionLabel"/>

            <LinearLayout
                    android:id="@+id/lowBandwidthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_low_bandwidth"
                            android:textColor="@color/fw_text_primary"
                            android:textSize="16sp"/>

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingMultiplier="1.15"
                            android:text="@string/settings_low_bandwidth_summary"
                            android:textColor="@color/fw_text_secondary"
                            android:textSize="13sp"/>
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/lowBandwidthMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_low_bandwidth"/>
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/viewerModeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_viewer_mode"
                            android:textColor="@color/fw_text_primary"
                            android:textSize="16sp"/>

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingMultiplier="1.15"
                            android:text="@string/settings_viewer_mode_summary"
                            android:textColor="@color/fw_text_secondary"
                            android:textSize="13sp"/>
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/viewerMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_viewer_mode"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="@dimen/fw_screen_padding"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/settings_save"
            android:textColor="@color/fw_on_accent"
            android:textStyle="bold"
            app:backgroundTint="@color/fw_accent"
            app:cornerRadius="@dimen/fw_card_radius"/>
</LinearLayout>
