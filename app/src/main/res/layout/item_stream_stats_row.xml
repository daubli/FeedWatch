<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:paddingTop="3dp"
              android:paddingBottom="3dp">

    <TextView
            android:id="@+id/streamStatsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/fw_text_secondary"
            android:textSize="12sp"
            tools:text="Received"/>

    <!-- tabular figures keep the column steady while the values change -->
    <TextView
            android:id="@+id/streamStatsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.FeedWatch.HudReadout"
            tools:text="50.0 fps"/>
</LinearLayout>
