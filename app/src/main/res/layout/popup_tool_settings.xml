<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:background="@drawable/bg_popup_menu"
              android:elevation="8dp"
              android:minWidth="220dp"
              android:orientation="vertical"
              android:padding="14dp">

    <TextView
            android:id="@+id/toolSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fw_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Focus peaking"/>

    <!-- one section per setting, added by ToolSettingsPopup -->
    <LinearLayout
            android:id="@+id/toolSettingsSections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
</LinearLayout>
