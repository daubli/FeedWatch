<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- FeedWatch is always dark, like a field monitor -->
    <style name="Theme.FeedWatch" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/fw_accent</item>
        <item name="colorPrimaryVariant">@color/fw_accent</item>
        <item name="colorOnPrimary">@color/fw_on_accent</item>
        <item name="colorSecondary">@color/fw_accent</item>
        <item name="colorSecondaryVariant">@color/fw_accent</item>
        <item name="colorOnSecondary">@color/fw_on_accent</item>
        <item name="colorSurface">@color/fw_surface</item>
        <item name="colorOnSurface">@color/fw_text_primary</item>
        <item name="colorControlNormal">@color/fw_text_secondary</item>
        <item name="android:colorBackground">@color/fw_background</item>
        <item name="android:windowBackground">@color/fw_background</item>
        <item name="android:textColorPrimary">@color/fw_text_primary</item>
        <item name="android:textColorSecondary">@color/fw_text_secondary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/fw_background</item>
        <item name="android:navigationBarColor">@color/fw_background</item>
        <item name="toolbarStyle">@style/Widget.FeedWatch.Toolbar</item>

        <!-- Public Sans everywhere: the default for plain text views, and the Material text styles widgets use.
             Not set as a theme-level fontFamily, which would override the weights chosen in text appearances. -->
        <item name="android:textAppearance">@style/TextAppearance.FeedWatch</item>
        <item name="textAppearanceHeadline1">@style/TextAppearance.FeedWatch.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.FeedWatch.Headline2</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.FeedWatch.Headline3</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.FeedWatch.Headline4</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.FeedWatch.Headline5</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.FeedWatch.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.FeedWatch.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.FeedWatch.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.FeedWatch.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.FeedWatch.Body2</item>
        <item name="textAppearanceButton">@style/TextAppearance.FeedWatch.Button</item>
        <item name="textAppearanceCaption">@style/TextAppearance.FeedWatch.Caption</item>
        <item name="textAppearanceOverline">@style/TextAppearance.FeedWatch.Overline</item>
    </style>

    <style name="Theme.FeedWatch.Fullscreen">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.FeedWatch.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/fw_background</item>
        <item name="titleTextAppearance">@style/TextAppearance.FeedWatch.ToolbarTitle</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="ThemeOverlay.FeedWatch.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">@color/fw_text_primary</item>
    </style>

    <style name="ThemeOverlay.FeedWatch.Popup" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="colorSurface">@color/fw_surface_raised</item>
        <item name="android:colorBackground">@color/fw_surface_raised</item>
    </style>

    <!-- Text -->
    <style name="TextAppearance.FeedWatch" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Headline3" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/public_sans_semibold</item>
        <item name="fontFamily">@font/public_sans_semibold</item>
    </style>

    <style name="TextAppearance.FeedWatch.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:fontFamily">@font/public_sans_medium</item>
        <item name="fontFamily">@font/public_sans_medium</item>
    </style>

    <style name="TextAppearance.FeedWatch.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/public_sans_semibold</item>
        <item name="fontFamily">@font/public_sans_semibold</item>
    </style>

    <style name="TextAppearance.FeedWatch.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="fontFamily">@font/public_sans</item>
    </style>

    <style name="TextAppearance.FeedWatch.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">@font/public_sans_medium</item>
        <item name="fontFamily">@font/public_sans_medium</item>
    </style>

    <style name="TextAppearance.FeedWatch.ToolbarTitle" parent="TextAppearance.FeedWatch.Headline6">
        <item name="android:textColor">@color/fw_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.FeedWatch.SectionLabel" parent="TextAppearance.FeedWatch.Overline">
        <item name="android:textColor">@color/fw_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">@font/public_sans_semibold</item>
        <item name="fontFamily">@font/public_sans_semibold</item>
    </style>

    <style name="TextAppearance.FeedWatch.Badge" parent="TextAppearance.FeedWatch.Caption">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">@font/public_sans_bold</item>
        <item name="fontFamily">@font/public_sans_bold</item>
    </style>

    <!-- Technical readouts in the stream HUD; tabular figures keep changing numbers from jumping around -->
    <style name="TextAppearance.FeedWatch.HudReadout" parent="TextAppearance.FeedWatch.Body2">
        <item name="android:textColor">@color/fw_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/public_sans_semibold</item>
        <item name="fontFamily">@font/public_sans_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Stream HUD pieces -->
    <style name="Widget.FeedWatch.HudChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/bg_hud_chip</item>
        <item name="android:textAppearance">@style/TextAppearance.FeedWatch.HudReadout</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.FeedWatch.ToolButton" parent="">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:drawableTint">@color/tool_button_content</item>
        <item name="android:textColor">@color/tool_button_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">@font/public_sans_semibold</item>
        <item name="fontFamily">@font/public_sans_semibold</item>
        <item name="android:background">@drawable/bg_tool_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
